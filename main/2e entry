setwd()

meta <- read.table("samples2.txt", header = TRUE, stringsAsFactors = FALSE)
colnames(meta) <- c("sample", "pop")

vcf <- read.vcfR("vcf/populations_filtered_snps.vcf.gz")
gen <- vcfR2genlight(vcf)

# Align sample order and assign population factors
meta <- meta[match(indNames(gen), meta$sample), ]
pop(gen) <- as.factor(meta$pop)

# have a look at the genind object:
gen

gen_matrix <- tab(gen, NA.method = "mean")
pca_res <- prcomp(gen_matrix, center = TRUE, scale. = FALSE)

pca_df <- as.data.frame(pca_res$x)
pca_df$sample <- indNames(gen)
pca_df$pop <- pop(gen)

eigs <- pca_res$sdev^2
pc1_var <- round((eigs[1] / sum(eigs)) * 100, 2)
pc2_var <- round((eigs[2] / sum(eigs)) * 100, 2)


ggplot(pca_df, aes(x = PC1, y = PC2, color = pop, label = sample)) +
  geom_point(size = 4, alpha = 0.8) +
  stat_ellipse(geom = "polygon", aes(fill = pop), alpha = 0.15, show.legend = FALSE) +
  scale_color_manual(values = c("OH-LV" = "#E69F00", "VA-BHG" = "#56B4E9", "WV-SR" = "#009E73")) +
  scale_fill_manual(values = c("OH-LV" = "#E69F00", "VA-BHG" = "#56B4E9", "WV-SR" = "#009E73")) +
  labs(
    title = "Principal Component Analysis (PCA)",
    x = paste0("PC1 (", pc1_var, "% variance)"),
    y = paste0("PC2 (", pc2_var, "% variance)"),
    color = "Population"
  ) +
  theme_minimal(base_size = 14)


# Define genotypes
gen_mat <- as.matrix(gen) ###################
hf_mat <- gen_mat
hf_mat[gen_mat == 0] <- 11
hf_mat[gen_mat == 1] <- 12
hf_mat[gen_mat == 2] <- 22

# Create a data frame for analysis

hf_data <- data.frame(pop = pop(gen), hf_mat)

overall_stats <- wc(hf_data)
cat("Overall Weir & Cockerham Fst:", round(overall_stats$FST, 4), "\n")

pairwise_fst <- pairwise.WCfst(hf_data)

pheatmap(
  pairwise_fst,
  display_numbers = TRUE,
  number_format = "%.3f",
  fontsize_number = 12,
  main = "Pairwise Weir & Cockerham Fst Heatmap",
  color = colorRampPalette(c("#F7FCF5", "#74C476", "#00441B"))(50),
  cluster_rows = FALSE,
  cluster_cols = FALSE
)

het_stats <- basic.stats(hf_data)

# 3.1 Drift: SFS & Heterozygosity
allele_counts <- colSums(as.matrix(gen), na.rm = TRUE)
allele_counts <- allele_counts[!is.na(allele_counts)]
sfs_df <- data.frame(Allele_Count = factor(allele_counts))

p_sfs <- ggplot(sfs_df, aes(x = Allele_Count)) +
  geom_bar(fill = "#0072B2", color = "black", width = 0.7) +
  labs(title = "Site Frequency Spectrum (SFS)", x = "Alternate Allele Count", y = "Number of Loci") +
  theme_classic(base_size = 12)

ho_means <- colMeans(het_stats$Ho, na.rm = TRUE)
hs_means <- colMeans(het_stats$Hs, na.rm = TRUE)
pop_names <- levels(pop(gen))

pop_het <- data.frame(
  pop = factor(rep(pop_names, 2), levels = pop_names),
  Metric = factor(c(rep("Expected (Hs)", length(pop_names)), rep("Observed (Ho)", length(pop_names))),
                  levels = c("Expected (Hs)", "Observed (Ho)")),
  Value = c(hs_means[pop_names], ho_means[pop_names])
)
pop_het$Value[is.na(pop_het$Value)] <- 0

p_het <- ggplot(pop_het, aes(x = pop, y = Value, fill = Metric)) +
  geom_bar(stat = "identity", position = position_dodge(width = 0.8), color = "black", width = 0.7) +
  scale_fill_manual(values = c("Expected (Hs)" = "#0072B2", "Observed (Ho)" = "#D55E00")) +
  labs(title = "Drift Signature: Ho vs. Hs", x = "Population", y = "Mean Heterozygosity") +
  theme_minimal(base_size = 12)

grid.arrange(p_sfs, p_het, ncol = 2)


if ("Fst" %in% colnames(het_stats$perloc)) {
  locus_fst <- het_stats$perloc$Fst
} else {
  locus_fst <- het_stats$perloc$FST
}
locus_fst[is.na(locus_fst) | locus_fst < 0] <- 0

outlier_df <- data.frame(Locus = 1:length(locus_fst), FST = locus_fst)
fst_threshold <- quantile(outlier_df$FST, 0.95, na.rm = TRUE)

ggplot(outlier_df, aes(x = Locus, y = FST)) +
  geom_point(aes(color = FST >= fst_threshold), size = 2.5) +
  geom_hline(yintercept = fst_threshold, linetype = "dashed", color = "red") +
  scale_color_manual(values = c("FALSE" = "grey50", "TRUE" = "#D55E00")) +
  labs(title = "Locus-Specific Fst Outlier Scan (Selection)", x = "SNP Index", y = "Fst") +
  theme_minimal(base_size = 14)


# Add lat/lon data 
pop_coords <- data.frame(pop = c("OH-LV", "VA-BHG", "WV-SR"), lat = c(41.1, 37.2, 38.8), lon = c(-81.5, -80.4, -79.8))
geo_dist <- as.matrix(dist(pop_coords[, c("lon", "lat")]))
rownames(geo_dist) <- colnames(geo_dist) <- pop_coords$pop
lin_fst <- pairwise_fst / (1 - pairwise_fst)

common_pops <- intersect(rownames(pairwise_fst), pop_coords$pop)
ibd_df <- data.frame(Geo_Dist = geo_dist[common_pops, common_pops][lower.tri(geo_dist[common_pops, common_pops])],
                     Lin_Fst  = lin_fst[common_pops, common_pops][lower.tri(lin_fst[common_pops, common_pops])])

ggplot(ibd_df, aes(x = Geo_Dist, y = Lin_Fst)) +
  geom_point(size = 4, color = "#7570B3") +
  geom_smooth(method = "lm", se = FALSE, color = "black", linetype = "dashed") +
  labs(title = "Isolation by Distance", x = "Geographic Distance", y = "Linearized Fst") +
  theme_classic(base_size = 14)

Ho_mat <- het_stats$Ho
Hs_mat <- het_stats$Hs
Fis_mat <- 1 - (Ho_mat / Hs_mat)

fis_list <- list()
for (p in pop_names) {
  p_fis <- Fis_mat[, p]
  p_fis <- p_fis[is.finite(p_fis)]
  if (length(p_fis) == 0) p_fis <- 0
  fis_list[[p]] <- data.frame(Population = p, FIS = p_fis)
}
fis_df <- do.call(rbind, fis_list)

ggplot(fis_df, aes(x = Population, y = FIS, fill = Population)) +
  geom_boxplot(alpha = 0.7) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
  scale_fill_manual(values = c("OH-LV" = "#E69F00", "VA-BHG" = "#56B4E9", "WV-SR" = "#009E73")) +
  labs(title = "Non-Random Mating: Fis Distribution", x = "Population", y = "Fis") +

conda create -n bio-tools python=3.10 samtools bedtools -y
conda install --name bio-tools seqtk
conda install --name bio-tools bwa-mem2
conda install --name bio-tools bcftools
conda install --name bio-tools bcftools
conda activate bio-tools

head Scut_reference.fasta
seqtk trimfq -b 20 -e 20 Scut_reference.fasta > Scut_reference_trimmed.fasta
# Verify header consistency
grep "^>" Scut_reference_trimmed.fasta | head -n 5


bwa-mem2 index Scut_reference_trimmed.fasta
samtools faidx Scut_reference_trimmed.fasta


THREADS="${THREADS:-$(($(nproc) - 1))}"
if [ "$THREADS" -lt 1 ]; then THREADS=1; fi
echo "Running alignment with ${THREADS} threads."
mkdir -p bams

# I ran this mem step as a shell instead. Forgot to unzip the reads directory at first
tail -n +2 samples2.txt | while read -r SAMPLE POP; do
# Skip empty lines
[ -z "$SAMPLE" ] && continue

echo "=================================================="
echo "Processing Sample: ${SAMPLE} (Population: ${POP})"
echo "=================================================="

R1="reads/${SAMPLE}_R1.fastq.gz"
R2="reads/${SAMPLE}_R2.fastq.gz"
OUT_BAM="bams/${SAMPLE}.sorted.bam"

RG="@RG\tID:${SAMPLE}\tSM:${SAMPLE}\tPL:ILLUMINA\tLB:${POP}"

#  alignment and sorting stream
bwa-mem2 mem -t "${THREADS}" -R "${RG}" Scut_reference_trimmed.fasta "${R1}" "${R2}" | \
samtools view -@ "${THREADS}" -u - | \
samtools sort -@ "${THREADS}" -o "${OUT_BAM}" -
  
  # Index sorted BAM
  samtools index -@ "${THREADS}" "${OUT_BAM}"

# Calculate summary statistics
samtools flagstat "${OUT_BAM}" > "bams/${SAMPLE}.flagstat.txt"

echo "Done: ${OUT_BAM}"
done

"
Reality check 1: What did the command above just do?
 
 The above commands looped through the forward and reverse reads for each sample and ran the mem tool with the t flag within the bwa-mem2 package. 
 This tool is apparently for genome alignment and the t flag simply sets threads. For each alignment, samtools is used to organize the (I guess they are genomes at this point?)
 and put them in a more convenient format for downstream analyses, saving each in the bams directory. The RG variable is just the indexing of headers for each sample specified by the -R flag in the mem.
"

mkdir -p vcf

ls bams/*.sorted.bam > bams/bam_list.txt

bcftools mpileup \
--threads ${THREADS} \
-f Scut_reference_trimmed.fasta \
-b bams/bam_list.txt \
-a FORMAT/AD,FORMAT/DP \
-d 8000 | \
bcftools call \
--threads ${THREADS} \
-m \
-v \
-O z \
-o vcf/populations_raw.vcf.gz

"
Reality check 2: what did the command above just do? What do all the flags mean (-m, -d, etc.)?

The above command mpileup creates a sort of distribution of variation ('genotype likelihoods') for each bam alignment.
Then the call tool (tool call) makes the definitive decision of what the locus should be based on each genotype likelihood. 
The m flag switches to a muli-allelic caller instead of the default. -v seems to simplify to variants and ignores conserved regions.
"


tabix -p vcf vcf/populations_raw.vcf.gz

bcftools view \
-v snps \
-m2 -M2 \
-i 'QUAL >= 30 && INFO/DP >= 10' \
vcf/populations_raw.vcf.gz \
-O z -o vcf/populations_filtered_snps.vcf.gz

tabix -p vcf vcf/populations_filtered_snps.vcf.gz

bcftools stats vcf/populations_filtered_snps.vcf.gz > vcf/vcf_stats.txt
cat vcf/vcf_stats.txt | grep "^SN"

# View the VCF header lines (definitions and sample names)
bcftools view -h vcf/populations_filtered_snps.vcf.gz | tail -n 5

# View the first few SNP records (CHROM, POS, REF, ALT, QUAL, FORMAT, and Genotypes)
bcftools view -H vcf/populations_filtered_snps.vcf.gz | head -n 5






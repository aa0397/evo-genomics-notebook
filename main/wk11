plot_astral_quartets <- function(tree_file, title_text, outgroup = "Brassavola-glauca_S40") {
  
  # 1. Read raw text string
  raw_str <- paste(readLines(tree_file, warn = FALSE), collapse = "")
  
  # 2. Extract q1, q2, q3 values directly from the ASTRAL comments
  astral_comments <- str_extract_all(raw_str, "'\\[.*?\\]'")[[1]]
  
  q_table <- tibble(comment = astral_comments) %>%
    mutate(
      q1_raw = as.numeric(str_extract(comment, "(?<=q1=)[0-9\\.e-]+")),
      q2_raw = as.numeric(str_extract(comment, "(?<=q2=)[0-9\\.e-]+")),
      q3_raw = as.numeric(str_extract(comment, "(?<=q3=)[0-9\\.e-]+"))
    ) %>%
    tidytree::mutate(
      q1 = pmax(0, q1_raw),
      q2 = pmax(0, q2_raw),
      q3 = pmax(0, q3_raw)
    )
  
  # 3. Clean Newick string and read tree
  clean_newick <- gsub("'\\[.*?\\]'", "", raw_str)
  tr <- read.tree(text = clean_newick)
  
  # 4. Root tree on outgroup
  if (outgroup %in% tr$tip.label) {
    tr <- root(tr, outgroup = outgroup, resolve.root = TRUE)
  }
  
  # 5. Build base ggtree plot
  p <- suppressWarnings(
    ggtree(tr) + 
      geom_tiplab(size = 3, fontface = "italic") +
      theme_tree2() +
      labs(title = title_text, subtitle = "Pie charts: q1 (Main), q2 (Alt 1), q3 (Alt 2)")
  )
  
  # 6. Align internal plot nodes with parsed quartet data table
  internal_nodes <- p$data %>% filter(!isTip)
  
  # Rooting creates an unannotated root node at the bottom of the tree.
  # Prepend an NA row to q_table so the 43 ASTRAL annotations align perfectly with internal nodes 2:44
  if (nrow(q_table) < nrow(internal_nodes)) {
    pad_diff <- nrow(internal_nodes) - nrow(q_table)
    pad_rows <- tibble(comment = rep(NA, pad_diff), 
                       q1_raw = NA, q2_raw = NA, q3_raw = NA, 
                       q1 = NA, q2 = NA, q3 = NA)
    q_padded <- bind_rows(pad_rows, q_table)
    quartet_df <- bind_cols(internal_nodes, q_padded)
  } else {
    quartet_df <- bind_cols(internal_nodes, q_table[1:nrow(internal_nodes), ])
  }
  
  # Filter out NAs for pie chart generation
  quartet_df_clean <- quartet_df %>% filter(!is.na(q1) & !is.na(q2) & !is.na(q3))
  
  # 7. Convert quartet values into a list of pie charts for ggtree
  pie_colors <- c("q1" = "#2b5c8f", "q2" = "#d95f02", "q3" = "#7570b3")
  pies <- nodepie(quartet_df_clean, cols = c("q1", "q2", "q3"), 
                  color = pie_colors, alpha = 0.9)
  
  # 8. Overlay pies directly onto tree nodes
  p_final <- inset(p, pies, width = 0.03, height = 0.03)
  
  # 9. Construct a clean legend using dummy points
  legend_data <- tibble(
    x = max(p$data$x, na.rm = TRUE),
    y = max(p$data$y, na.rm = TRUE),
    Quartet = factor(c("q1 (Main Topology)", "q2 (Alternative 1)", "q3 (Alternative 2)"),
                     levels = c("q1 (Main Topology)", "q2 (Alternative 1)", "q3 (Alternative 2)"))
  )
  
  p_final <- p_final + 
    geom_point(data = legend_data, aes(x = x, y = y, color = Quartet), alpha = 0, size = 0) +
    scale_color_manual(
      values = c("q1 (Main Topology)" = "#2b5c8f", 
                 "q2 (Alternative 1)" = "#d95f02", 
                 "q3 (Alternative 2)" = "#7570b3"),
      name = "Quartet Frequencies"
    ) +
    guides(color = guide_legend(override.aes = list(alpha = 1, size = 4))) +
    theme(
      legend.position = c(0.85, 0.25),
      legend.background = element_rect(fill = "white", color = "gray80"),
      legend.title = element_text(face = "bold", size = 10),
      legend.text = element_text(size = 9)
    ) +
    xlim(0, max(p$data$x, na.rm = TRUE) * 1.45)
  
  return(p_final)
}


library(tidyverse)
library(ape)
library(ggtree)
library(treeio)
require(pak)

outgroup_taxon <- "Brassavola-glauca_S40"

plot_rooted_tree <- function(tree_file, title_text) {
  # 1. Read tree using ape
  tr <- read.tree(tree_file)
  
  # 2. Root tree on outgroup
  if (outgroup_taxon %in% tr$tip.label) {
    tr <- root(tr, outgroup = outgroup_taxon, resolve.root = TRUE)
  }
  
  # 3. Align node.label vector length to prevent tree mismatch warnings
  num_nodes <- tr$Nnode
  if (!is.null(tr$node.label)) {
    if (length(tr$node.label) < num_nodes) {
      tr$node.label <- c(tr$node.label, rep("", num_nodes - length(tr$node.label)))
    } else if (length(tr$node.label) > num_nodes) {
      tr$node.label <- tr$node.label[1:num_nodes]
    }
  }
  
  # 4. Base tree plot - suppress fortify() deprecation warnings
  p <- suppressWarnings(
    ggtree(tr) +
      geom_tiplab(size = 3, fontface = "italic") +
      theme_tree2() +
      labs(title = title_text)
  )
  
  # 5. Extract and print internal node support labels
  p <- p + 
    geom_text2(
      aes(subset = !isTip & !is.na(label) & label != "", label = label),
      hjust = 1.2, 
      vjust = -0.4, 
      size = 2.8, 
      color = "darkblue"
    )
  
  # 6. Dynamically set x-axis buffer for long taxon tip labels
  p <- p + xlim(0, max(p$data$x, na.rm = TRUE) * 1.35)
  
  return(p)
}

# Run plotting pipeline cleanly
p1 <- plot_rooted_tree("tree_5gene_astral.tre", "5-Gene w-ASTRAL Species Tree")
p2 <- plot_rooted_tree("tree_5gene_supermatrix.tre", "5-Gene Concatenated Supermatrix (ML)")
p3 <- plot_rooted_tree("tree_272gene_astral.tre", "272-Gene w-ASTRAL Species Tree")
p4 <- plot_rooted_tree("tree_272gene_supermatrix.tre", "272-Gene Concatenated Supermatrix (ML)")

# Display trees
print(p1)
print(p2)
print(p3)
print(p4)

